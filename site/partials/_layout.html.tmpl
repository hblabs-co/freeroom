{{ define "_layout" }}<!doctype html>
<html lang="{{ .Lang }}" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{/* themeBoot follows prefers-color-scheme; no manual toggle on purpose, so the
     <picture> light/dark sources always agree with the page theme. */}}
{{ themeBoot }}
<title>{{ T .Lang "site.title" }}</title>
<meta name="description" content="{{ T .Lang "site.description" }}">
{{ if or (eq .PageKey "thanks") (eq .PageKey "request-failed") }}<meta name="robots" content="noindex">
{{ end }}<link rel="canonical" href="{{ canonical .Path }}">
{{ range .Langs }}<link rel="alternate" hreflang="{{ . }}" href="{{ canonical (pageURL . $.PageKey) }}">
{{ end }}<link rel="alternate" hreflang="x-default" href="{{ canonical (pageURL .DefaultLang .PageKey) }}">
<meta property="og:title" content="{{ T .Lang "site.title" }}">
<meta property="og:description" content="{{ T .Lang "site.description" }}">
<meta property="og:url" content="{{ canonical .Path }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ .Lang }}">
{{/* Link-preview image per language, generated by scripts/og (go run ./scripts/og).
     Static instead of the shared og renderer, whose font only covers Latin scripts. */}}
{{ $og := asset (printf "img/og/%s.jpg" .Lang) }}
<meta property="og:image" content="{{ canonical $og }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Freeroom">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ canonical $og }}">
<link rel="icon" type="image/svg+xml" href="{{ asset "img/favicon.svg" }}">
<link rel="apple-touch-icon" href="{{ asset "img/apple-touch-icon.png" }}">
<link rel="stylesheet" href="{{ asset "uikit/css/tokens.css" }}">
<link rel="stylesheet" href="{{ asset "uikit/css/components.css" }}">
<link rel="stylesheet" href="{{ asset "css/freeroom.css" }}">
<script src="{{ asset "js/freeroom.js" }}" defer></script>
</head>
<body>
<header class="site-header">
  <a class="brand" href="{{ pageURL .Lang "" }}">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="{{ asset "img/freeroom-icon-dark.svg" }}">
      <img class="brand-icon" src="{{ asset "img/freeroom-icon-light.svg" }}" alt="" width="32" height="32">
    </picture>
    <span class="brand-text">Freeroom</span>
  </a>
  <nav class="primary-nav" aria-label="primary">
    <a href="{{ pageURL .Lang "" }}#features">{{ T .Lang "nav.features" }}</a>
    <a href="{{ pageURL .Lang "" }}#safety">{{ T .Lang "nav.safety" }}</a>
    <a href="{{ pageURL .Lang "" }}#install">{{ T .Lang "nav.install" }}</a>
    <a href="{{ pageURL .Lang "" }}#request">{{ T .Lang "nav.request" }}</a>
    <a href="https://github.com/hblabs-co/freeroom" rel="noopener">{{ T .Lang "nav.github" }}</a>
  </nav>
  <details class="lang-switch">
    <summary aria-label="{{ T .Lang "nav.lang_aria" }}">{{ icon "globe" 16 }} <span>{{ langName .Lang }}</span></summary>
    <ul role="list">
      {{ range .Langs }}<li><a href="{{ pageURL . $.PageKey }}" hreflang="{{ . }}" lang="{{ . }}"{{ if eq . $.Lang }} aria-current="true"{{ end }}>{{ langName . }}</a></li>
      {{ end }}
    </ul>
  </details>
</header>

<main>
  {{ template "content" . }}
</main>

<footer class="site-footer">
  <p class="site-footer__by">
    <picture>
      <source media="(prefers-color-scheme: dark)" srcset="{{ asset "uikit/brand/logo-mono-dark.svg" }}">
      <img class="site-footer__logo" src="{{ asset "uikit/brand/logo-mono-light.svg" }}" alt="" width="22" height="22">
    </picture>
    {{ T .Lang "footer.by" }}
  </p>
  <ul class="site-footer__links" role="list">
    <li><a href="https://github.com/hblabs-co/freeroom" rel="noopener">GitHub</a></li>
    <li><a href="https://github.com/hblabs-co/freeroom/releases" rel="noopener">{{ T .Lang "footer.releases" }}</a></li>
    <li><a href="https://github.com/hblabs-co/freeroom/blob/main/LICENSE" rel="noopener">{{ T .Lang "footer.license" }}</a></li>
    <li><a href="{{ hblabsURL .Lang "legal" }}">{{ T .Lang "footer.legal" }}</a></li>
    <li><a href="{{ hblabsURL .Lang "privacy" }}">{{ T .Lang "footer.privacy" }}</a></li>
    <li><a href="https://hblabs.co/{{ if eq .Lang "de" "es" "en" "nl" }}{{ .Lang }}/{{ end }}">hblabs.co</a></li>
  </ul>
  <p class="site-footer__copy">© {{ .Year }} {{ legalEntity }}</p>
</footer>
{{ devScript }}
</body>
</html>
{{ end }}
